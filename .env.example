# Copy this file to .env and fill in real values. Never commit .env.

# Required for audits, keyword search, and trend discovery.
# Get a free key: console.cloud.google.com -> APIs & Services -> Credentials
# Enable "YouTube Data API v3" on the project first.
YOUTUBE_API_KEY=

# Postgres connection string. Local dev can use SQLite instead (see prisma/schema.prisma).
# Render/Railway both give you a ready-made DATABASE_URL when you add a Postgres instance.
DATABASE_URL="file:./dev.db"

# Optional, needed once you wire up the AI Generator (Section 8 of the build prompt).
# Not required for the MVP screens included in this scaffold.
ANTHROPIC_API_KEY=

# Optional, needed once billing (Section 17) is implemented.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional, needed once "connect your channel" (OAuth) is implemented.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
